# Copy this file to .env on the machine that runs the application.
# Never include the real .env in a ZIP, Git repository or submission.

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

LOCAL_MODELS_ONLY=true
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_DATASETS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

DISTILBERT_SENTIMENT_MODEL_PATH=outputs/models/distilbert_sentiment
MINILM_MODEL_PATH=outputs/models/all-MiniLM-L6-v2
RATING_MODEL_PATH=outputs/models/nlptown_bert_rating

GOOGLE_MAPS_CDP_URL=http://127.0.0.1:9222
GOOGLE_MAPS_BRIDGE_TIMEOUT_SECONDS=1800
GOOGLE_MAPS_HEADLESS=false

FLASK_DEBUG=false
PORT=5000
STRICT_MODEL_EXECUTION=true
